<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="student" class="com.jh.spring.Student">
        <property name="name" value="赵六"/>
        <property name="age" value="20"/>
    </bean>

    <bean id="studentDaoJdbc" class="com.jh.spring.StudentDaoJdbcImpl"/>
    <bean id="studentDaoMybatis" class="com.jh.spring.StudentDaoMybatisImpl"/>

    <bean id="studentService" class="com.jh.spring.StudentService">
        <property name="studentDao" ref="studentDaoMybatis"/>
    </bean>
</beans>
